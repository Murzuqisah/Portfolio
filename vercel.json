{
    "version": 2,
    "routes": [
      {
        "src": "^/routes/send-email$",
        "dest": "/index.js",
        "methods": ["POST"]
      },
      {
        "src": "/(.*)",
        "dest": "/index.js"
      }
    ],
    "functions": {
        "index.js": {
            "includeFiles": "public/**"
        }
    },
    "github": {
        "silent": true
    }
}